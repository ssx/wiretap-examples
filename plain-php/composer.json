{
    "name": "ssx/wiretap-example-plain-php",
    "description": "Minimal wiretap example with no framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ssx/wiretap": "dev-main",
        "ssx/wiretap-guzzle": "dev-main",
        "guzzlehttp/guzzle": "^7.5"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/ssx/wiretap" },
        { "type": "vcs", "url": "https://github.com/ssx/wiretap-guzzle" }
    ],
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": {
        "allow-plugins": { "php-http/discovery": false }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
