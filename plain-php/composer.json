{
    "name": "ssx/wiretap-example-plain-php",
    "description": "Minimal wiretap example with no framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ssx/wiretap": "~0.0.1",
        "ssx/wiretap-guzzle": "~0.0.1",
        "guzzlehttp/guzzle": "^7.5"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ssx/wiretap"
        },
        {
            "type": "vcs",
            "url": "https://github.com/ssx/wiretap-guzzle"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
